{
  "manifest_version": 3,
  "name": "Auto Lot Saver",
  "version": "1.0.0",
  "description": "Сохраняет данные и фотографии выбранного автомобильного лота.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://aukcje.efl.com.pl/*",
    "https://www.otomoto.pl/*",
    "https://www.auto1.com/*",
    "https://carmarket.ayvens.com/*",
    "https://remktg.arval.com/*",
    "https://autoselect.arval.pl/*",
    "https://www.bca.com/*",
    "https://*.bca.com/*",
    "https://*.bca-online-auctions.eu/*",
    "https://www.bcaimage.com/*",
    "https://bcaimage.com/*",
    "https://bcamediaprod.blob.core.windows.net/*",
    "https://*.autoselect.cloud/*",
    "https://arvalprodeuwsa.blob.core.windows.net/*"
  ],
  "action": { "default_popup": "popup.html", "default_title": "Auto Lot Saver" },
  "content_scripts": [{
    "matches": [
      "https://aukcje.efl.com.pl/*", "https://www.otomoto.pl/*", "https://www.auto1.com/*",
      "https://carmarket.ayvens.com/*", "https://remktg.arval.com/*", "https://autoselect.arval.pl/*",
      "https://www.bca.com/*"
    ],
    "js": [
      "parsers/remktg.js",
      "parsers/efl.js",
      "parsers/otomoto.js",
      "parsers/auto1.js",
      "parsers/ayvens.js",
      "parsers/arval-autoselect.js",
      "parsers/bca.js",
      "content.js"
    ],
    "run_at": "document_idle"
  }]
}
